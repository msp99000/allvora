# Copy to .env.local for development. Set the same keys in the Vercel project
# (Settings > Environment Variables) for Production, Preview and Development.

# --- RFQ email delivery -----------------------------------------------------
# Without all three, /api/rfq logs the enquiry to the server console and still
# returns success, so the form stays testable locally.
RESEND_API_KEY=
RFQ_TO_EMAIL=            # where enquiries land, e.g. sales@allvora.com
RFQ_FROM_EMAIL=          # must be on a domain verified in Resend

# --- Certifications ---------------------------------------------------------
# Leave unset to show unconfirmed registrations with a "pending" marker.
# Set to false to hide them entirely until Allvora confirms them.
# NEXT_PUBLIC_SHOW_UNCONFIRMED_CERTS=false
